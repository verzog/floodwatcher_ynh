#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SETTINGS
#=================================================

_fw_default_settings

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"

_fw_write_config
_fw_set_permissions

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

_fw_add_cron

ynh_config_add_logrotate "/var/log/$app"

#=================================================
# DATABASE AND FIRST DATA
#=================================================
ynh_script_progression "Setting up the database..."

_fw_setup_data

# The collectors start on their own schedule (within 10 minutes) and the flood maps download
# within half an hour; nothing more to wait for here.

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"

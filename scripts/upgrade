#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# SETTINGS (new ones get their defaults)
#=================================================

_fw_default_settings

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Replace the code from the package's own "sources/" folder (one repo, no separate upstream).
# Nothing in install_dir is kept: config.php is rewritten below, and everything the app writes
# lives in the data folder. Clear the old code first (so a file removed between versions doesn't
# linger), then copy the current code in.
find "${install_dir:?}/" -mindepth 1 -delete
cp -r ../sources/. "$install_dir/"

_fw_write_config
_fw_set_permissions

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_phpfpm

ynh_config_add_nginx

_fw_add_cron

ynh_config_add_logrotate "/var/log/$app"

#=================================================
# DATABASE
#=================================================
ynh_script_progression "Upgrading the database..."

_fw_setup_data

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
